<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>NupkgWrenchExe</id>
    <version>$version$</version>
    <authors>emgarten</authors>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <license type="expression">MIT</license>
    <icon>icon.png</icon>
    <readme>PACKAGE.md</readme>
    <projectUrl>https://github.com/emgarten/NupkgWrench</projectUrl>
    <description>NupkgWrench is a command line tool to read and modify nupkgs. This package contains NupkgWrench.exe, an alternative to the dotnet tool.</description>
    <copyright>$copyright$</copyright>
    <tags>nupkg nuget-powertool</tags>
    <repository type="git" url="https://github.com/emgarten/NupkgWrench" branch="$branch$" commit="$commit$" />
    <developmentDependency>true</developmentDependency>
  </metadata>
  <files>
    <file src="..\..\artifacts\publish\NupkgWrench.exe" target="tools\" />
    <file src="NupkgWrenchExe.props" target="build\" />
    <file src="..\..\build\icons\icon.png" target="" />
    <file src="NupkgWrenchExe.PACKAGE.md" target="PACKAGE.md" />
  </files>
</package>
